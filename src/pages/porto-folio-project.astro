---
import Layout from '../layouts/Layout.astro';

interface PortfolioItem {
  id: string;
  image: string;
  brandLogo: string;
  brandName: string;
  lines: string[];
}

const projects: PortfolioItem[] = [
  {
    id: 'marunda-project',
    image: '/images/portfolio-marunda.webp',
    brandLogo: '/images/brand-armstrong.webp',
    brandName: 'ARMSTRONG',
    lines: ['Marunda project,', 'Acoustic ceiling.']
  },
  {
    id: 'datacenter-project',
    image: '/images/portfolio-datacenter-alt.webp',
    brandLogo: '/images/brand-metallux.webp',
    brandName: 'METALLUX',
    lines: ['Data center (server room),', ' bandara project.', 'Metal ceiling']
  }
];
---

<Layout
  title="Porto Folio Project - MITRA88 SUPPLY"
  description="MITRA88 SUPPLY merupakan badan usaha yang berfokus pada solusi ceiling (plafon) modern. Kami melayani sebagai reseller material plafon akustik (acoustic ceiling), metal ceiling, gypsum, serta menyediakan jasa pemasangan profesional untuk berbagai skala proyek."
  currentPath="/porto-folio-project"
>
  <div class="page-container">
    <!-- PAGE HEADER -->
    <header class="page-header">
      <div class="container text-center">
        <h1 class="page-title">Porto Folio Project</h1>
      </div>
    </header>

    <!-- PORTFOLIO PROJECTS SECTION -->
    <section class="portfolio-section">
      <div class="container">
        <div class="portfolio-grid">
          {projects.map((proj) => (
            <article class="portfolio-card" id={proj.id}>
              <!-- PHOTO CONTAINER (Slot siap untuk 3-5 foto tambahan dari klien) -->
              <div class="portfolio-card__photo-frame">
                <img
                  src={proj.image}
                  alt={proj.lines.join(' ')}
                  width="600"
                  height="450"
                  loading="lazy"
                  class="portfolio-photo"
                />
              </div>

              <div class="portfolio-card__body">
                <div class="portfolio-card__brand">
                  <img src={proj.brandLogo} alt={proj.brandName} height="28" loading="lazy" class="brand-img" />
                </div>

                <h2 class="portfolio-card__heading">
                  {proj.lines.map((line) => (
                    <span class="heading-line">{line}</span>
                  ))}
                </h2>
              </div>
            </article>
          ))}
        </div>

        <!-- YOUTUBE SECTION -->
        <div class="yt-banner">
          <div class="yt-banner__container">
            <div class="yt-banner__icon">
              <img src="/images/icon-youtube.webp" alt="YouTube Icon" width="64" height="64" loading="lazy" />
            </div>

            <div class="yt-banner__content">
              <h2 class="yt-banner__text">
                Porto Folio lainnya dapat dilihat di channel Youtube kami :
              </h2>
            </div>

            <div class="yt-banner__action">
              <a
                href="https://youtube.com/@mitra88supply"
                target="_blank"
                rel="noopener noreferrer"
                class="yt-btn"
                aria-label="Lihat di Youtube"
              >
                <span>Lihat di Youtube</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-container {
    padding-bottom: 5rem;
  }

  /* PAGE HEADER */
  .page-header {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 3.5rem 0 2.5rem;
  }

  .page-title {
    font-size: 3rem;
    font-weight: 900;
    color: #1e293b;
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* PORTFOLIO SECTION */
  .portfolio-section {
    padding: 4rem 0;
  }

  .portfolio-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem;
    margin-bottom: 4rem;
  }

  .portfolio-card {
    background-color: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
    display: flex;
    flex-direction: column;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .portfolio-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.09);
  }

  .portfolio-card__photo-frame {
    width: 100%;
    height: 380px;
    background-color: #0f172a;
    overflow: hidden;
  }

  .portfolio-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .portfolio-card:hover .portfolio-photo {
    transform: scale(1.03);
  }

  .portfolio-card__body {
    padding: 2rem 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    flex: 1;
    background-color: #ffffff;
  }

  .portfolio-card__brand {
    display: flex;
    align-items: center;
  }

  .brand-img {
    max-height: 30px;
    width: auto;
    object-fit: contain;
  }

  .portfolio-card__heading {
    font-size: 1.6rem;
    font-weight: 800;
    color: #1e293b;
    line-height: 1.35;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .heading-line {
    display: block;
  }

  /* YOUTUBE BANNER */
  .yt-banner {
    background: linear-gradient(135deg, #ffffff 0%, #fff5f5 100%);
    border: 2px solid #fee2e2;
    border-radius: 16px;
    padding: 2.5rem 3rem;
    box-shadow: 0 8px 24px rgba(220, 38, 38, 0.08);
  }

  .yt-banner__container {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .yt-banner__icon {
    flex-shrink: 0;
  }

  .yt-banner__content {
    flex: 1;
  }

  .yt-banner__text {
    font-size: 1.45rem;
    font-weight: 800;
    color: #1e293b;
    margin: 0;
    line-height: 1.35;
  }

  .yt-banner__action {
    flex-shrink: 0;
  }

  .yt-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background-color: #ff0000;
    color: #ffffff;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 1.12rem;
    text-decoration: none;
    padding: 0.95rem 2rem;
    border-radius: 10px;
    box-shadow: 0 4px 14px rgba(255, 0, 0, 0.35);
    transition: all 0.25s ease;
  }

  .yt-btn:hover {
    background-color: #cc0000;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(255, 0, 0, 0.45);
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .portfolio-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .portfolio-card__photo-frame {
      height: 300px;
    }
    .yt-banner__container {
      flex-direction: column;
      text-align: center;
      gap: 1.5rem;
    }
    .yt-banner {
      padding: 2rem 1.5rem;
    }
  }

  @media (max-width: 640px) {
    .page-title {
      font-size: 2.25rem;
    }
    .portfolio-card__photo-frame {
      height: 220px;
    }
    .portfolio-card__body {
      padding: 1.5rem 1.25rem;
    }
    .portfolio-card__heading {
      font-size: 1.35rem;
    }
    .yt-banner__text {
      font-size: 1.2rem;
    }
    .yt-btn {
      width: 100%;
    }
  }
</style>
