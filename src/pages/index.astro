---
import Layout from '../layouts/Layout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<Layout
  title="Tentang Kami - MITRA88 SUPPLY"
  description="MITRA88 SUPPLY merupakan badan usaha yang berfokus pada solusi ceiling (plafon) modern. Kami melayani sebagai reseller material plafon akustik (acoustic ceiling), metal ceiling, gypsum, serta menyediakan jasa pemasangan profesional untuk berbagai skala proyek."
  currentPath="/"
>
  <!-- SECTION 0: TENTANG KAMI -->
  <section class="about-hero-section">
    <div class="container about-hero-container">
      <div class="about-hero-visual">
        <div class="poster-frame">
          <img
            src="/images/poster-hero.webp"
            alt="MITRA88 SUPPLY"
            width="839"
            height="636"
            fetchpriority="high"
            class="poster-img"
          />
        </div>
      </div>

      <div class="about-hero-content">
        <h1 class="about-title">Tentang Kami</h1>

        <div class="about-text-group">
          <p>
            <strong>MITRA88 SUPPLY</strong> merupakan badan usaha yang berfokus pada solusi ceiling (plafon) modern.
          </p>
          <p>
            Kami melayani sebagai reseller material plafon akustik (<em>acoustic ceiling</em>), metal ceiling, gypsum, serta menyediakan jasa pemasangan profesional untuk berbagai skala proyek.
          </p>
          <p>
            Dengan pengalaman dan dedikasi, kami hadir untuk memenuhi kebutuhan estetika dan fungsionalitas ceiling bangunan Anda.
          </p>
        </div>

        <div class="about-hero-actions">
          <WhatsAppButton variant="large" text="Chat WA" />
        </div>
      </div>
    </div>
  </section>

  <!-- SECTION 1: BANNER KEUNGGULAN -->
  <section class="banner-section">
    <div class="container">
      <div class="banner-frame">
        <img
          src="/images/banner-keunggulan.webp"
          alt="MITRA88 SUPPLY"
          width="1448"
          height="1086"
          loading="lazy"
          class="banner-img"
        />
      </div>
    </div>
  </section>

  <!-- SECTION 2: SOLUSI CEILING SESUAI KEBUTUHAN ANDA! -->
  <section class="solutions-section">
    <div class="container solutions-container">
      <div class="solutions-content">
        <h2 class="solutions-title">
          Solusi ceiling sesuai<br />kebutuhan Anda!
        </h2>

        <div class="solutions-body">
          <p class="solutions-intro">
            Kami menawarkan solusi ceiling (plafon) sesuai dengan kebutuhan Anda, seperti :
          </p>
          <ul class="solutions-list">
            <li>Area Office (koridor dan meeting room) dengan menggunakan acoustic ceiling atau gyptile ceiling.</li>
            <li>Area koridor bandara, data center (server room), atau area pantry (kitchen) menggunakan metal ceiling.</li>
          </ul>
        </div>

        <div class="solutions-action">
          <a href="/layanan" class="solutions-btn">
            <span>Produk dan Layanan</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>

      <div class="solutions-gallery">
        <div class="solutions-photo-card">
          <img
            src="/images/portfolio-installation.webp"
            alt="Pemasangan Ceiling Mitra 88 Supply"
            width="720"
            height="1280"
            loading="lazy"
            class="solutions-photo"
          />
        </div>
        <div class="solutions-photo-card">
          <img
            src="/images/portfolio-hallway-alt.webp"
            alt="Plafon Area Koridor Mitra 88 Supply"
            width="1200"
            height="1600"
            loading="lazy"
            class="solutions-photo"
          />
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* SECTION 0: TENTANG KAMI */
  .about-hero-section {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 4.5rem 0 5rem;
  }

  .about-hero-container {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 3.5rem;
    align-items: center;
  }

  .about-hero-visual {
    width: 100%;
  }

  .poster-frame {
    background-color: #ffffff;
    border-radius: 16px;
    border: 1px solid #cbd5e1;
    box-shadow: 0 15px 35px -10px rgba(15, 23, 42, 0.12);
    overflow: hidden;
  }

  .poster-img {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .about-hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-title {
    font-size: 3rem;
    font-weight: 900;
    color: #1e293b;
    line-height: 1.15;
    margin: 0;
    letter-spacing: -0.025em;
  }

  .about-text-group {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .about-text-group p {
    font-size: 1.08rem;
    color: #334155;
    line-height: 1.7;
    margin: 0;
  }

  .about-hero-actions {
    margin-top: 0.5rem;
  }

  /* SECTION 1: BANNER */
  .banner-section {
    padding: 4rem 0;
    background-color: #f8fafc;
    border-bottom: 1px solid #e2e8f0;
  }

  .banner-frame {
    max-width: 1050px;
    margin: 0 auto;
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 12px 30px rgba(15, 23, 42, 0.08);
    border: 1px solid #e2e8f0;
    background: #ffffff;
  }

  .banner-img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* SECTION 2: SOLUSI CEILING */
  .solutions-section {
    padding: 5rem 0;
    background-color: #ffffff;
  }

  .solutions-container {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .solutions-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .solutions-title {
    font-size: 2.75rem;
    font-weight: 900;
    color: #1e293b;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .solutions-intro {
    font-size: 1.12rem;
    font-style: italic;
    font-weight: 700;
    color: #1e293b;
    line-height: 1.5;
    margin: 0 0 1rem;
  }

  .solutions-list {
    list-style: disc;
    padding-left: 1.5rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .solutions-list li {
    font-size: 1.05rem;
    color: #004aad;
    font-weight: 700;
    line-height: 1.6;
  }

  .solutions-action {
    margin-top: 1rem;
  }

  .solutions-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background-color: #ff3131;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 1.12rem;
    font-weight: 700;
    padding: 0.95rem 2rem;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(255, 49, 49, 0.35);
    transition: all 0.2s ease;
  }

  .solutions-btn:hover {
    background-color: #e02424;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(255, 49, 49, 0.45);
    color: #ffffff;
  }

  .solutions-gallery {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }

  .solutions-photo-card {
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.08);
    border: 1px solid #e2e8f0;
    height: 380px;
    background-color: #f1f5f9;
  }

  .solutions-photo {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .solutions-photo-card:hover .solutions-photo {
    transform: scale(1.03);
  }

  /* RESPONSIVE */
  @media (max-width: 992px) {
    .about-hero-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
    .solutions-container {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }

  @media (max-width: 640px) {
    .about-hero-section {
      padding: 3rem 0;
    }
    .about-title {
      font-size: 2.25rem;
    }
    .about-text-group p {
      font-size: 0.98rem;
    }
    .banner-section {
      padding: 2.5rem 0;
    }
    .solutions-section {
      padding: 3.5rem 0;
    }
    .solutions-title {
      font-size: 2rem;
    }
    .solutions-intro {
      font-size: 1rem;
    }
    .solutions-list li {
      font-size: 0.95rem;
    }
    .solutions-gallery {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .solutions-photo-card {
      height: 240px;
    }
    .solutions-btn {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }
</style>
