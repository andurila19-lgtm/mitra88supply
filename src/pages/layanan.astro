---
import Layout from '../layouts/Layout.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface ProductItem {
  id: string;
  category: string;
  titleColor: string;
  brand: string;
  brandLogos?: string[];
  image: string;
  badgeText?: string;
  description: string;
  specs: {
    brand: string;
    type: string[];
    size: string;
  };
  callout: string;
  revisionNotice?: string;
}

const products: ProductItem[] = [
  {
    id: 'metal-ceiling-metallux',
    category: 'METAL CEILING',
    titleColor: '#004aad',
    brand: 'Metallux',
    image: '/images/product-metallux-600.webp',
    description:
      'Kami menjual dan menawarkan jasa pasang metal ceiling material alumunium dengan finishing coating. Diaplikasikan untuk data center (server room), kitchen area, bandara, dan lain-lain yang membutuhkan suhu stabil dalam ruangan.',
    specs: {
      brand: 'Metallux',
      type: ['(1) Lay-in Plain', '(2) Perforated (bolong2)'],
      size: '600x600x0.6mm'
    },
    callout: 'Untuk info detail dan harga, silakan hubungi kami (fast respon).'
  },
  {
    id: 'acoustic-ceiling-armstrong',
    category: 'ACOUSTIC CEILING',
    titleColor: '#00bf63',
    brand: 'ARMSTRONG',
    brandLogos: ['/images/brand-armstrong.webp', '/images/brand-knauf.webp'],
    image: '/images/product-armstrong-acoustic.webp',
    description:
      'Kami menjual dan menawarkan jasa pasang acoustic ceiling berbahan fiber serat optik, diaplikasikan untuk ruangan yang membutuhkan kedap suara.',
    specs: {
      brand: 'ARMSTRONG',
      type: [
        '* ANF RH95, size : 600x1200x15mm.',
        '* Classic Lite RH99, size : 600x1200x16mm.',
        '* Fine Fissured RH99, size : 600x1200x16mm.',
        '* Dune #3641B, size : 600x1200x16mm.'
      ],
      size: ''
    },
    callout: 'Untuk info detail dan harga, silakan hubungi kami (fast respon).'
  },
  {
    id: 'gyptile-ceiling-jayapanel',
    category: 'GYPTILE CEILING',
    titleColor: '#004aad',
    brand: 'JAYA PANEL (USG BORAL)',
    brandLogos: ['/images/brand-usg-boral.webp'],
    image: '/images/product-jayapanel-gyptile.webp',
    // CATATAN KHUSUS: MENUNGGU TEKS REVISI DARI KLIEN
    // Mempertahankan teks asli Canva sumber kebenaran tanpa menebak atau menulis ulang deskripsi.
    revisionNotice: 'Menunggu revisi teks dari klien',
    description:
      'Kami menjual dan menawarkan jasa pasang metal ceiling material alumunium dengan finishing coating. Diaplikasikan untuk data center (server room), kitchen area, bandara, dan lain-lain yang membutuhkan suhu stabil dalam ruangan.',
    specs: {
      brand: 'JAYA PANEL (USG BORAL)',
      type: ['Byhua'],
      size: '600x1200x0.9mm'
    },
    callout: 'Untuk info detail dan harga, silakan hubungi kami (fast respon).'
  },
  {
    id: 'acoustic-ceiling-usgboral',
    category: 'ACOUSTIC CEILING',
    titleColor: '#00bf63',
    brand: 'USG BORAL',
    brandLogos: ['/images/brand-usg-boral.webp'],
    image: '/images/product-usg-pinperf.webp',
    description:
      'Kami menjual dan menawarkan jasa pasang acoustic ceiling berbahan fiber serat optik, diaplikasikan untuk ruangan yang membutuhkan kedap suara.',
    specs: {
      brand: 'USG BORAL',
      type: ['* Pin Perf, size : 600x1200x16mm.'],
      size: ''
    },
    callout: 'Untuk info detail dan harga, silakan hubungi kami (fast respon).'
  },
  {
    id: 'acoustic-ceiling-thermatex',
    category: 'ACOUSTIC CEILING',
    titleColor: '#00bf63',
    brand: 'AMF THERMATEX',
    brandLogos: ['/images/brand-amf.webp', '/images/brand-knauf.webp'],
    badgeText: 'THERMATEX',
    image: '/images/product-pinperf-sample.webp',
    description:
      'Kami menjual dan menawarkan jasa pasang acoustic ceiling berbahan fiber serat optik, diaplikasikan untuk ruangan yang membutuhkan kedap suara.',
    specs: {
      brand: 'AMF THERMATEX',
      type: ['Star Board, size : 600x1200x15mm.'],
      size: ''
    },
    callout: 'Untuk info detail dan harga, silakan hubungi kami (fast respon).'
  }
];
---

<Layout
  title="Produk dan Layanan - MITRA88 SUPPLY"
  description="MITRA88 SUPPLY merupakan badan usaha yang berfokus pada solusi ceiling (plafon) modern. Kami melayani sebagai reseller material plafon akustik (acoustic ceiling), metal ceiling, gypsum, serta menyediakan jasa pemasangan profesional untuk berbagai skala proyek."
  currentPath="/layanan"
>
  <div class="page-container">
    <!-- PAGE HEADER -->
    <header class="page-header">
      <div class="container text-center">
        <h1 class="page-title">Produk dan Layanan</h1>
      </div>
    </header>

    <!-- PRODUCTS CATALOG -->
    <section class="products-section">
      <div class="container">
        <div class="products-list">
          {products.map((item, index) => (
            <article class="product-card" id={item.id}>
              <!-- PHOTO CONTAINER (Slot siap untuk 3-5 foto tambahan dari klien) -->
              <div class="product-card__photo-col">
                <div class="product-card__photo-frame">
                  <img
                    src={item.image}
                    alt={item.category}
                    width="600"
                    height="450"
                    loading={index < 2 ? 'eager' : 'lazy'}
                    class="product-photo"
                  />
                  {item.badgeText && (
                    <span class="product-badge">{item.badgeText}</span>
                  )}
                </div>

                {item.brandLogos && item.brandLogos.length > 0 && (
                  <div class="product-card__brand-logos">
                    {item.brandLogos.map(logo => (
                      <img src={logo} alt={item.brand} height="28" loading="lazy" class="brand-logo-img" />
                    ))}
                  </div>
                )}
              </div>

              <!-- CONTENT DETAILS -->
              <div class="product-card__content-col">
                <h2 class="product-category-title" style={`color: ${item.titleColor};`}>
                  {item.category}
                </h2>

                <p class="product-desc">{item.description}</p>

                <div class="product-specs">
                  <p class="spec-line">
                    <strong>Brand :</strong> <span class="spec-brand">{item.specs.brand}</span>
                  </p>
                  
                  {item.specs.type.length > 0 && (
                    <div class="spec-type-group">
                      <strong>Type :</strong>
                      <ul class="spec-type-list">
                        {item.specs.type.map(t => (
                          <li>{t}</li>
                        ))}
                      </ul>
                    </div>
                  )}

                  {item.specs.size && (
                    <p class="spec-line">
                      <strong>Size :</strong> {item.specs.size}
                    </p>
                  )}
                </div>

                <p class="product-callout">{item.callout}</p>

                <div class="product-card__action">
                  <WhatsAppButton variant="primary" text="Chat WA" />
                </div>
              </div>
            </article>
          ))}
        </div>

        <!-- PAGE NAVIGATION ACTION -->
        <div class="page-nav-action text-center">
          <a href="/porto-folio-project" class="porto-btn">
            <span>Porto Folio Project</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>

<style>
  .page-container {
    padding-bottom: 5rem;
  }

  /* PAGE HEADER */
  .page-header {
    background-color: #ffffff;
    border-bottom: 1px solid #e2e8f0;
    padding: 3.5rem 0 2.5rem;
  }

  .page-title {
    font-size: 3rem;
    font-weight: 900;
    color: #1e293b;
    margin: 0;
    letter-spacing: -0.02em;
  }

  /* PRODUCTS SECTION */
  .products-section {
    padding: 4rem 0;
  }

  .products-list {
    display: flex;
    flex-direction: column;
    gap: 3.5rem;
  }

  .product-card {
    background-color: #ffffff;
    border-radius: 16px;
    border: 1px solid #e2e8f0;
    overflow: hidden;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .product-card:hover {
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.08);
  }

  .product-card__photo-col {
    background-color: #f8fafc;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    border-right: 1px solid #f1f5f9;
  }

  .product-card__photo-frame {
    position: relative;
    width: 100%;
    max-width: 440px;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 14px rgba(0, 0, 0, 0.08);
    background-color: #ffffff;
  }

  .product-photo {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .product-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background-color: rgba(0, 0, 0, 0.75);
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.25rem 0.65rem;
    border-radius: 4px;
    letter-spacing: 0.05em;
  }

  .product-card__brand-logos {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    flex-wrap: wrap;
  }

  .brand-logo-img {
    max-height: 28px;
    width: auto;
    object-fit: contain;
  }

  .product-card__content-col {
    padding: 2.5rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .product-category-title {
    font-size: 2rem;
    font-weight: 900;
    font-style: italic;
    margin: 0;
    line-height: 1.2;
  }

  .product-desc {
    font-size: 1.02rem;
    color: #334155;
    line-height: 1.65;
    margin: 0;
  }

  .product-specs {
    background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 1.25rem 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.95rem;
    color: #1e293b;
  }

  .spec-line {
    margin: 0;
    line-height: 1.5;
  }

  .spec-brand {
    color: #004aad;
    font-weight: 700;
  }

  .spec-type-group {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .spec-type-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    color: #475569;
  }

  .product-callout {
    font-size: 0.98rem;
    font-weight: 700;
    font-style: italic;
    color: #ff3131;
    margin: 0;
  }

  .product-card__action {
    margin-top: auto;
    padding-top: 0.75rem;
  }

  /* PAGE ACTION */
  .page-nav-action {
    margin-top: 4.5rem;
  }

  .porto-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    background-color: #004aad;
    color: #ffffff;
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    padding: 1rem 2.25rem;
    border-radius: 8px;
    text-decoration: none;
    box-shadow: 0 6px 18px rgba(0, 74, 173, 0.35);
    transition: all 0.2s ease;
  }

  .porto-btn:hover {
    background-color: #003680;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 74, 173, 0.45);
    color: #ffffff;
  }

  /* RESPONSIVE */
  @media (max-width: 900px) {
    .product-card {
      grid-template-columns: 1fr;
    }
    .product-card__photo-col {
      border-right: none;
      border-bottom: 1px solid #f1f5f9;
      padding: 1.5rem;
    }
    .product-card__content-col {
      padding: 1.75rem 1.25rem;
    }
  }

  @media (max-width: 640px) {
    .page-title {
      font-size: 2.25rem;
    }
    .product-category-title {
      font-size: 1.6rem;
    }
    .product-desc {
      font-size: 0.95rem;
    }
    .product-specs {
      padding: 1rem;
      font-size: 0.9rem;
    }
    .porto-btn {
      width: 100%;
      justify-content: center;
      text-align: center;
    }
  }
</style>
