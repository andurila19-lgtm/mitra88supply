---
interface Props {
  text?: string;
  variant?: 'primary' | 'inline' | 'floating' | 'large' | 'card';
  message?: string;
  class?: string;
}

const {
  text = 'Chat WA',
  variant = 'primary',
  message = 'Halo Mitra 88 Supply, saya ingin info detail dan harga produk ceiling...',
  class: className = ''
} = Astro.props;

const phone = '6281322090199';
const encodedMessage = encodeURIComponent(message);
const waUrl = `https://wa.me/${phone}?text=${encodedMessage}`;
---

<a
  href={waUrl}
  target="_blank"
  rel="noopener noreferrer"
  class={`wa-btn wa-btn--${variant} ${className}`}
  aria-label={`Hubungi Mitra 88 Supply via WhatsApp: 0813-2209-0199`}
>
  <span class="wa-btn__icon" aria-hidden="true">
    <svg viewBox="0 0 32 32" width="22" height="22" fill="currentColor">
      <path d="M16 2a13.9 13.9 0 0 0-12 21l-2 7.7 8-2A13.9 13.9 0 1 0 16 2zm0 25.5c-2.3 0-4.5-.6-6.4-1.8l-.5-.3-4.7 1.2 1.3-4.6-.3-.5A11.5 11.5 0 1 1 16 27.5zm6.3-8.6c-.3-.2-2-.9-2.3-1s-.5-.2-.7.2-.8 1-1 1.2-.4.2-.7 0a9.2 9.2 0 0 1-2.7-1.7 10.2 10.2 0 0 1-1.9-2.3c-.2-.3 0-.5.2-.7s.3-.4.5-.5a2 2 0 0 0 .3-.5.7.7 0 0 0 0-.6c0-.2-.7-1.8-1-2.4s-.6-.5-.8-.5h-.7a1.4 1.4 0 0 0-1 .5 4.3 4.3 0 0 0-1.3 3.2 7.5 7.5 0 0 0 1.6 4 17.2 17.2 0 0 0 6.6 5.8c3.9 1.7 3.9 1.1 4.6 1.1a3.9 3.9 0 0 0 2.6-1.8 3.2 3.2 0 0 0 .2-1.8c-.2-.2-.4-.3-.7-.5z"/>
    </svg>
  </span>
  <span class="wa-btn__text">{text}</span>
</a>

<style>
  .wa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    font-family: 'DM Sans', system-ui, sans-serif;
    font-weight: 700;
    text-decoration: none;
    border-radius: 8px;
    transition: all 0.25s ease;
    cursor: pointer;
    box-sizing: border-box;
    white-space: nowrap;
  }

  .wa-btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  /* Variant: Primary */
  .wa-btn--primary {
    background-color: #00b050;
    color: #ffffff;
    padding: 0.7rem 1.4rem;
    font-size: 1rem;
    box-shadow: 0 4px 14px rgba(0, 176, 80, 0.35);
  }

  .wa-btn--primary:hover {
    background-color: #009944;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(0, 176, 80, 0.45);
  }

  /* Variant: Large */
  .wa-btn--large {
    background-color: #00b050;
    color: #ffffff;
    padding: 0.95rem 2rem;
    font-size: 1.15rem;
    letter-spacing: 0.02em;
    border-radius: 10px;
    box-shadow: 0 6px 20px rgba(0, 176, 80, 0.35);
  }

  .wa-btn--large:hover {
    background-color: #009944;
    color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(0, 176, 80, 0.45);
  }

  /* Variant: Card */
  .wa-btn--card {
    background-color: #00b050;
    color: #ffffff;
    padding: 0.6rem 1.2rem;
    font-size: 0.92rem;
    width: 100%;
    margin-top: 1rem;
  }

  .wa-btn--card:hover {
    background-color: #009944;
    color: #ffffff;
  }

  /* Variant: Floating */
  .wa-btn--floating {
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 90;
    background-color: #25d366;
    color: #ffffff;
    padding: 0.75rem 1.25rem;
    border-radius: 50px;
    font-size: 0.92rem;
    box-shadow: 0 6px 22px rgba(37, 211, 102, 0.45);
    border: 2px solid rgba(255, 255, 255, 0.4);
  }

  .wa-btn--floating:hover {
    background-color: #20ba59;
    color: #ffffff;
    box-shadow: 0 8px 26px rgba(37, 211, 102, 0.55);
  }

  /* Mobile floating button: clean circular icon badge */
  @media (max-width: 640px) {
    .wa-btn--floating {
      width: 52px;
      height: 52px;
      padding: 0;
      border-radius: 50%;
      bottom: 20px;
      right: 20px;
      justify-content: center;
    }

    .wa-btn--floating .wa-btn__icon svg {
      width: 28px;
      height: 28px;
    }

    .wa-btn--floating .wa-btn__text {
      display: none;
    }
  }
</style>
